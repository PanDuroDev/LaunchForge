{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchforge.dev/schemas/publisher-artifact-inventory-v1.schema.json",
  "title": "LaunchForge Publisher Artifact Inventory v1",
  "description": "Publisher-side inventory for release QA. This is not a launcher updater manifest or a trust statement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "version",
    "channel",
    "source_revision",
    "build",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "preview"
      ]
    },
    "source_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "toolchain",
        "built_at_utc"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{1,32}$"
        },
        "toolchain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "built_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "platform",
          "package_type",
          "size_bytes",
          "sha256",
          "signing"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^/\\\\]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$"
          },
          "platform": {
            "type": "string",
            "pattern": "^windows-[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "package_type": {
            "enum": [
              "installer",
              "portable"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854776000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "subject",
              "certificate_thumbprint",
              "timestamped",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "signed",
                  "unsigned",
                  "not-applicable"
                ]
              },
              "subject": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              },
              "certificate_thumbprint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timestamped": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 512
              }
            },
            "oneOf": [
              {
                "properties": {
                  "status": {
                    "const": "signed"
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "certificate_thumbprint": {
                    "type": "string",
                    "pattern": "^(?:[0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$"
                  },
                  "timestamped": {
                    "const": true
                  },
                  "reason": {
                    "type": "null"
                  }
                }
              },
              {
                "properties": {
                  "status": {
                    "enum": [
                      "unsigned",
                      "not-applicable"
                    ]
                  },
                  "subject": {
                    "type": "null"
                  },
                  "certificate_thumbprint": {
                    "type": "null"
                  },
                  "timestamped": {
                    "const": false
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "stable"
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "artifacts": {
            "items": {
              "properties": {
                "signing": {
                  "properties": {
                    "status": {
                      "const": "signed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "enum": [
              "beta",
              "preview"
            ]
          }
        },
        "required": [
          "channel"
        ]
      },
      "then": {
        "properties": {
          "version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          }
        }
      }
    }
  ]
}
